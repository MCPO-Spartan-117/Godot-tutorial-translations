[configuration]

entry_symbol = "example_library_init"
compatibility_minimum = "4.5.1"
reloadable = true

[libraries]

macos.debug = "res://CPP/Creep/bin/libCreep.macos.template_debug.dev.framework"
macos.release = "res://CPP/Creep/bin/libCreep.macos.template_release.framework"
ios.debug = "res://CPP/Creep/bin/libCreep.ios.template_debug.dev.xcframework"
ios.release = "res://CPP/Creep/bin/libCreep.ios.template_release.xcframework"
windows.debug.x86_32 = "res://CPP/Creep/bin/libCreep.windows.template_debug.dev.x86_32.dll"
windows.release.x86_32 = "res://CPP/Creep/bin/libCreep.windows.template_release.x86_32.dll"
windows.debug.x86_64 = "res://CPP/Creep/bin/libCreep.windows.template_debug.dev.x86_64.dll"
windows.release.x86_64 = "res://CPP/Creep/bin/libCreep.windows.template_release.x86_64.dll"
linux.debug.x86_64 = "res://CPP/Creep/bin/libCreep.linux.template_debug.dev.x86_64.so"
linux.release.x86_64 = "res://CPP/Creep/bin/libCreep.linux.template_release.x86_64.so"
linux.debug.arm64 = "res://CPP/Creep/bin/libCreep.linux.template_debug.dev.arm64.so"
linux.release.arm64 = "res://CPP/Creep/bin/libCreep.linux.template_release.arm64.so"
linux.debug.rv64 = "res://CPP/Creep/bin/libCreep.linux.template_debug.dev.rv64.so"
linux.release.rv64 = "res://CPP/Creep/bin/libCreep.linux.template_release.rv64.so"
android.debug.x86_64 = "res://CPP/Creep/bin/libCreep.android.template_debug.dev.x86_64.so"
android.release.x86_64 = "res://CPP/Creep/bin/libCreep.android.template_release.x86_64.so"
android.debug.arm64 = "res://CPP/Creep/bin/libCreep.android.template_debug.dev.arm64.so"
android.release.arm64 = "res://CPP/Creep/bin/libCreep.android.template_release.arm64.so"

[dependencies]
ios.debug = {
    "res://CPP/Creep/bin/libgodot-cpp.ios.template_debug.dev.xcframework": ""
}
ios.release = {
    "res://CPP/Creep/bin/libgodot-cpp.ios.template_release.xcframework": ""
}
